# Avoid PATH leaking into actions
common --incompatible_strict_action_env

# Don't fail on unknown GPUs, add needed GPUs to common.MODULE.bazel
common --repo_env=MOJO_IGNORE_UNKNOWN_GPUS=1

# Silence warnings in external dependencies used in tests
build --per_file_copt=external/.*@-w --host_per_file_copt=external/.*@-w

import %workspace%/bazel/internal/common.bazelrc

# Load config generated from tools/bazel
import %workspace%/build/wrapper.bazelrc

build --remote_instance_name=modular-public

build --compilation_mode=dbg
build --//:modular_config=default

build:ci --mojoprecompilecopt=-Werror

build:public-cache --bes_backend=grpcs://modular-public.buildbuddy.io
build:public-cache --bes_results_url=https://modular-public.buildbuddy.io/invocation/
build:public-cache --build_metadata=VISIBILITY=PUBLIC
build:public-cache --remote_downloader=grpcs://modular-public.buildbuddy.io
build:public-cache --remote_cache=grpcs://modular-public.buildbuddy.io

build:build-mojo --//:use_prebuilt_mojo_toolchain=false
build:prebuilt-mojo --//:use_prebuilt_mojo_toolchain=true

# Cross build for a Windows x86_64 target. Combine it with --config=build-mojo and
# with the --repo_env flag that scripts/windows-sysroot.sh prints, which is not in
# here because the sysroot path is different on every machine.
#
# MODULAR_TARGET has to be set alongside the platform rather than only the
# platform. bazel/internal/cfg_workaround.bzl reads it to decide whether the tools
# the build runs on the way to its outputs, the Mojo compiler among them, belong in
# the exec configuration or the target one. With the variable unset it assumes they
# are wanted for the target, which is right for an ordinary build where the two are
# the same machine and wrong here: the compiler gets cross built to Windows and
# Bazel then tries to run it on the Linux host.
build:windows --platforms=//:windows-x86_64-platform
build:windows --repo_env=MODULAR_TARGET=windows:x86_64

# A test harness runs on the machine driving the build and not on the target. See
# bazel/internal/cross_platform_test.bzl for what that costs and why it is needed.
build:windows --//bazel/internal:cross_test

# Check for a local gitignored bazel config.
# NOTE: Import this last so that local configs can override.
try-import %workspace%/local.bazelrc
