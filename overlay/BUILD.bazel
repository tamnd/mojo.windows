###
# Downstream distributor identity
###
#
# Empty by default, so a Modular build prints exactly what it printed before and
# pays nothing for these. Anyone shipping a modified build sets them, and
# `mojo --version` then names who produced the binary and which upstream commit
# it came from. The licence grants no trademark rights, and a bug in a modified
# build is not Modular's to fix, so the binary should say all of that itself
# rather than relying on whoever files the report to remember.

string_flag(
    name = "downstream_id",
    build_setting_default = "",
)

string_flag(
    name = "downstream_build",
    build_setting_default = "",
)

string_flag(
    name = "downstream_upstream_commit",
    build_setting_default = "",
)

