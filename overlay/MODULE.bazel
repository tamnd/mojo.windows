"""Define bazel dependencies."""

module(
    name = "modular",
    version = "0",
)

include("//bazel:common.MODULE.bazel")

mojo_aliases = use_repo_rule("//bazel:mojo_aliases.bzl", "mojo_aliases")

mojo_aliases(name = "mojo")

modular_wheel_repository = use_repo_rule("//bazel:modular_wheel_repository.bzl", "modular_wheel_repository")

modular_wheel_repository(name = "modular_wheel")

macos_sysroot_repository = use_repo_rule("//bazel/internal/cc-toolchain:macos_sysroot_repository.bzl", "macos_sysroot_repository")

macos_sysroot_repository(name = "sysroot-macos")

windows_sysroot_repository = use_repo_rule("//bazel/internal/cc-toolchain:windows_sysroot_repository.bzl", "windows_sysroot_repository")

windows_sysroot_repository(name = "sysroot-windows")

host_clang_repository = use_repo_rule("//bazel/internal/cc-toolchain:host_clang_repository.bzl", "host_clang_repository")

host_clang_repository(name = "host-clang")

host_python_repository = use_repo_rule("//bazel/internal/cc-toolchain:host_python_repository.bzl", "host_python_repository")

host_python_repository(name = "host-python")

include("//bazel:mojo.MODULE.bazel")

link_hack = use_repo_rule("//bazel/internal:link_hack.bzl", "link_hack")

link_hack(
    name = "build_bazel_rules_android",  # See link_hack.bzl for details
)

register_toolchains(
    "//bazel/internal:mojo_toolchain",
    "@mojo_toolchains//...",
    "//bazel/internal/cc-toolchain:all",
    "//bazel/internal:mojo_copts_toolchain",
    # Windows targets only, and it has to be registered from the root module so that
    # it is considered before the one @bazel_tools//tools/test registers. The comment
    # on the target in the root BUILD file says what it is for.
    "//:windows_test_toolchain",
)

llvm_source = use_extension("//bazel/public-patches:llvm_source.bzl", "llvm_source")

# extra_patches is the hook llvm_source.bzl already offers for exactly this, so we
# do not have to touch its PATCHES list and pick up a conflict on every bump.
llvm_source.configure(extra_patches = [
    "//bazel/public-patches:llvm_windows_stack_flag.patch",
    "//bazel/public-patches:llvm_windows_absolute_symlinks.patch",
])

use_repo(llvm_source, "llvm-raw")

llvm_configure = use_extension("//bazel/public-patches:llvm_project.bzl", "llvm_configure")
use_repo(llvm_configure, "llvm-project")

cfg_workaround = use_repo_rule("//bazel/internal:cfg_workaround.bzl", "cfg_workaround")

cfg_workaround(name = "cfg_workaround.bzl")
