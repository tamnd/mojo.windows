mojo_copts_toolchain(
    name = "_mojo_copts_toolchain",
    copts = select({
        "//:linux_x86_64": [
            "-target-triple=x86_64-unknown-linux-gnu",
            "--target-cpu=x86-64-v3",
        ],
        "//:linux_aarch64": [
            "-target-triple=aarch64-unknown-linux-gnu",
            "--target-cpu=neoverse-n1",
        ],
        "@platforms//os:macos": [
            "--target-cpu=apple-m1",
        ],
        # The Linux arms pick x86-64-v3 and neoverse-n1, which are reasonable when you
        # know what your machines are. Nothing is known about the machines a Windows
        # build lands on, so this one is picked from the other end: the oldest thing
        # the release notes are willing to promise.
        #
        # x86-64-v3 wants AVX2, which is Haswell in 2013 on the Intel side and
        # Excavator in 2015 on the AMD side, and the way a binary built for it fails
        # on anything older is an illegal instruction with no message. x86-64-v2 wants
        # SSE4.2, POPCNT and CMPXCHG16B, which is Nehalem in 2008 and Bulldozer in
        # 2011. The claimed minimum is Windows 10 1809, and that runs happily on
        # Nehalem era hardware, so v3 would quietly contradict the support claim and
        # v2 does not. See #43 and #65.
        #
        # Not generic x86-64 either, because POPCNT and SSE4.2 are exactly what a
        # compiler's hashing and small string work uses, and a machine that cannot do
        # v2 is a 2008 machine that is not going to be running a Mojo compiler.
        #
        # This has to stay in step with -march in the cc-toolchain, which is where the
        # same baseline is set for the C++ side.
        "//:windows_x86_64": [
            "-target-triple=x86_64-pc-windows-msvc",
            "--target-cpu=x86-64-v2",
        ],
    }) + select({
        "//:asan": ["--sanitize=address"],
        "//:tsan": ["--sanitize=thread"],
        "//conditions:default": [],
    }) + select({
        "//:modular_config_ci_build": ["-Werror"],
        "//conditions:default": [],
    }),
    precompile_copts = select({
        "//:modular_config_ci_build": ["-Werror"],
        "//conditions:default": [],
    }),
    tags = [TOP_LEVEL_TAG],  # Used in MODULE.bazel
)

mojo_toolchain(
    name = "mojo_toolchain_target",
    # Every Mojo target links these, which is where they have to be. The symbol is reached
    # from generated code rather than from anything a BUILD file names, so a per target
    # dependency would mean adding one to every target that happens to format a 128 bit
    # integer, and finding out which those are by watching links fail.
    implicit_deps = select({
        "//:windows_x86_64": [":windows_compiler_rt_builtins"],
        "//conditions:default": [],
    }),
    lld = "@llvm-project//lld:lld",
    mojo = "//Mojo/tools/mojo",
    tags = [
        # Manual so that even in --config=prebuilt-mojo this
        # doesn't build, since we build this folder in the OSS CI.
        "manual",
        TOP_LEVEL_TAG,  # Used in oss.MODULE.bazel
    ],
)

# Don't split toolchains on OS, we don't care about cross compilation here.
toolchain(
    name = "mojo_toolchain",
    tags = [TOP_LEVEL_TAG],  # Used in oss.MODULE.bazel
    target_settings = ["//:use_prebuilt_mojo_toolchain_disabled"],
    toolchain = ":mojo_toolchain_target",
    toolchain_type = "@rules_mojo//:toolchain_type",
)

toolchain(
    name = "mojo_copts_toolchain",
    tags = [TOP_LEVEL_TAG],  # Used in MODULE.bazel
    toolchain = ":_mojo_copts_toolchain",
    toolchain_type = "@rules_mojo//:copts_toolchain_type",
)

