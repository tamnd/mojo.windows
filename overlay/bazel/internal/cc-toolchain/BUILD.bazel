load("//bazel/internal/cc-toolchain/tools:tools.bzl", "PLATFORMS")  # buildifier: disable=bzl-visibility

package(default_visibility = ["//visibility:public"])

cc_sysroot(
    name = "linux_sysroot_aarch64",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    allowlist_include_directories = ["@sysroot-jammy-aarch64//sysroot:root"],
    data = ["@sysroot-jammy-aarch64//sysroot:directory"],
    sysroot = "@sysroot-jammy-aarch64//sysroot:root",
)

cc_sysroot(
    name = "linux_sysroot_x86_64",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    allowlist_include_directories = ["@sysroot-jammy-x86_64//sysroot:root"],
    data = ["@sysroot-jammy-x86_64//sysroot:directory"],
    sysroot = "@sysroot-jammy-x86_64//sysroot:root",
)

cc_sysroot(
    name = "macos_sysroot",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    allowlist_include_directories = ["@sysroot-macos//sysroot:root"],
    data = ["@sysroot-macos//sysroot:directory"],
    sysroot = "@sysroot-macos//sysroot:root",
)

# Not a cc_sysroot, and the difference is the point. cc_sysroot emits --sysroot=DIR,
# which is a Unix idea: one directory with usr/include and usr/lib underneath it, laid
# out the way the compiler already expects. Microsoft's headers and import libraries are
# not laid out that way and clang's msvc driver does not look for them that way, so the
# paths have to be handed over one at a time. The seven below are exactly the seven the
# splat produces, and they are the same seven the sysroot repository rule globs, so if
# you add one here add it there too or Bazel will pass a path to a directory it did not
# make an input.
#
# Nothing here fails when MOJO_WINDOWS_SYSROOT is unset. The repository is still a valid
# empty one, {root} still resolves, and clang silently ignores include directories that
# do not exist, so analysis works everywhere and only a real compile hits missing
# headers. See windows_sysroot_repository.bzl.
#
# The headers and the import libraries are two targets rather than one because they go on
# different actions. The three sysroots above get away with one because --sysroot means
# something to both halves of the driver. A -L on a compile is an argument clang never
# reads, and this toolchain builds with -Werror=unused-command-line-argument, so putting
# all seven on every action turns every compile into three errors about the linker.
# The MSVC and SDK directories go on with -idirafter, and that is the whole point of this
# target rather than a detail of it. -idirafter searches a directory only once every -I and
# -isystem and clang's own builtin directory have been exhausted, while still treating it as
# a system directory so its warnings stay suppressed. That is exactly what clang-cl's -imsvc
# does, and -imsvc exists because this problem is unavoidable when you compile against
# Microsoft's headers. The GNU driver rejects -imsvc outright, so we spell it this way.
#
# Two separate bugs come from getting this order wrong and they look nothing alike.
#
# The CRT ships its own xmmintrin.h and immintrin.h defining __m128 as a union of arrays,
# the way cl wants it, where clang's define it as a vector type. Everything clang compiles
# expects the vector, so LLVM's own libc writes ymm[0] and gets "type '__m128' (aka 'union
# __m128') does not provide a subscript operator". That needs the builtin directory ahead
# of the sysroot.
#
# The SDK also ships a share.h, and so does curl, and curl's is the one curl means. A target
# puts its own include directories on with -isystem, and the toolchain's -isystem entries
# land on the command line first, so the SDK won and four functions curl declares
# unconditionally came out undeclared. That needs the sysroot behind every target's own
# directories, which -isystem cannot express at all and -idirafter does by definition.
#
# The second one is the one to hold on to. It is not curl's bug and it is not about curl.
# The CRT and the SDK between them own a few thousand short generic header names, and under
# -isystem every one of those is a name a first or third party header cannot safely use.
#
# The resource directory entry below is now redundant, since -idirafter puts the sysroot
# behind the builtin directory whether we name it or not. It stays because it says out loud
# that clang's headers have to come first, and a line that states a requirement is worth
# more than a flag saved.
cc_args(
    name = "windows_sysroot_headers",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    allowlist_include_directories = [
        "@sysroot-windows//sysroot:root",
        "//bazel/internal/cc-toolchain/tools:resource_directory",
    ],
    args = [
        "-isystem",
        "{resource_dir}/include",
        "-idirafter",
        "{root}/crt/include",
        "-idirafter",
        "{root}/sdk/include/ucrt",
        "-idirafter",
        "{root}/sdk/include/um",
        "-idirafter",
        "{root}/sdk/include/shared",
    ],
    data = [
        "@sysroot-windows//sysroot:directory",
        "//bazel/internal/cc-toolchain/tools:resource_directory_filegroup",
    ],
    format = {
        "resource_dir": "//bazel/internal/cc-toolchain/tools:resource_directory_filegroup",
        "root": "@sysroot-windows//sysroot:root",
    },
)

# minwindef.h defines min and max as function-like macros, so std::numeric_limits<T>::max()
# expands to something that is not a call and the error talks about binary operands. On a
# -k build of //Support:all that one macro pair was 228 errors, all of them in boringssl and
# none of them boringssl's fault. NOMINMAX has been the documented way to turn it off since
# the 1990s.
#
# On the toolchain rather than on a target because every target that reaches a Windows
# header has the same exposure, and a target that reaches none is unaffected by a define it
# never uses.
cc_args(
    name = "windows_defines",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = ["-DNOMINMAX"],
)

cc_args(
    name = "windows_sysroot_libraries",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-L",
        "{root}/crt/lib/x86_64",
        "-L",
        "{root}/sdk/lib/ucrt/x86_64",
        "-L",
        "{root}/sdk/lib/um/x86_64",
    ],
    data = ["@sysroot-windows//sysroot:directory"],
    format = {"root": "@sysroot-windows//sysroot:root"},
)

[
    cc_toolchain(
        name = "{}_clang_toolchain".format(platform),
        args = select({
            "//:linux_x86_64": [":linux_sysroot_x86_64"],
            "//:linux_aarch64": [":linux_sysroot_aarch64"],
            "@platforms//os:macos": [":macos_sysroot"],
            "@platforms//os:windows": [
                ":windows_defines",
                ":windows_sysroot_headers",
                ":windows_sysroot_libraries",
            ],
        }) + [
            "//bazel/internal/cc-toolchain/args:resource_dir_args",
            "//bazel/internal/cc-toolchain/args:compile_and_link_args",
            "//bazel/internal/cc-toolchain/args:compile_args",
            "//bazel/internal/cc-toolchain/args:cpp_compile_args",
            "//bazel/internal/cc-toolchain/args:link_args",
            "//bazel/internal/cc-toolchain/args:link_executable_args",
            "//bazel/internal/cc-toolchain/args:link_shared_library_args",
            "//bazel/internal/cc-toolchain/args/modular:first_party",
            "//bazel/internal/cc-toolchain/args/modular:third_party",
            "//bazel/internal/cc-toolchain/args:compile_warnings",
            "//bazel/internal/cc-toolchain/args:compile_warnings_as_errors",
            "//bazel/internal/cc-toolchain/args/modular:assertions",  # Comes after warnings to allow disabling them
            "//bazel/internal/cc-toolchain/args:ignore_unused_command_line_argument",
        ] + select({
            "@platforms//os:linux": [
                "@rules_cc//cc/toolchains/args/soname_flags:set_soname",
            ],
            "//conditions:default": [],
        }),
        artifact_name_patterns = select({
            "@platforms//os:macos": [
                ":macos-dylib-pattern",
                ":macos-tbd-pattern",
            ],
            "@platforms//os:windows": [
                ":windows-executable-pattern",
                ":windows-object-pattern",
                ":windows-static-library-pattern",
                ":windows-alwayslink-static-library-pattern",
                ":windows-dll-pattern",
                ":windows-implib-pattern",
            ],
            "//conditions:default": [],
        }),
        compiler = "clang",
        enabled_features = select({
            # NOTE: Must come before default features which can override these
            "//:modular_config_asan": ["//bazel/internal/cc-toolchain/features:asan"],
            "//:modular_config_tsan": ["//bazel/internal/cc-toolchain/features:tsan"],
            "//:modular_config_ubsan": ["//bazel/internal/cc-toolchain/features:ubsan"],
            "//conditions:default": [],
        }) + [
            # Features where order doesn't matter
            "//bazel/internal/cc-toolchain/features:archive_param_file",
            "//bazel/internal/cc-toolchain/features:gcc_quoting_for_param_files",
            "//bazel/internal/cc-toolchain/features:module_maps",
            "//bazel/internal/cc-toolchain/features:non_opt_feature",
            "//bazel/internal/cc-toolchain/features:set_soname",
            "//bazel/internal/cc-toolchain/features:sysroot",
            "@rules_cc//cc/toolchains/args/preprocessor_defines:feature",
            "@rules_cc//cc/toolchains/args/random_seed:feature",
            "//bazel/internal/cc-toolchain/features:external_include_paths",

            # NOTE: Order matters, some flags must come before default flags
            "//bazel/internal/cc-toolchain/features:parse_headers_shim",
            "//bazel/internal/cc-toolchain/features:opt_feature",
            "@rules_cc//cc/toolchains/args:experimental_replace_legacy_action_config_features",
            "//bazel/internal/cc-toolchain/features:supports_start_end_lib",  # https://github.com/bazelbuild/rules_cc/issues/322
            "//bazel/internal/cc-toolchain/args/interface-libraries",
        ] + select({
            # Bazel puts every shared library in a _solib_<cpu> tree at the top of
            # the output tree and relies on an rpath to reach it from wherever the
            # binary ended up. Windows has no rpath, and the PE loader's search order
            # starts with the directory the executable is in and never looks three
            # levels up, so a binary built this way cannot find a single one of its
            # DLLs. Turning this on makes Bazel put a copy of each of them beside the
            # binary, which is the one place the loader is guaranteed to look.
            "@platforms//os:windows": [
                "//bazel/internal/cc-toolchain/features:copy_dynamic_libraries_to_binary",
            ],
            "//conditions:default": [],
        }),
        known_features = [
            # Only optional features need to be included here
            "//bazel/internal/cc-toolchain/features:asan",
            "//bazel/internal/cc-toolchain/features:tsan",
            "//bazel/internal/cc-toolchain/features:ubsan",
            "//bazel/internal/cc-toolchain/features:dbg_stub",
            "//bazel/internal/cc-toolchain/features:fastbuild_stub",
            "//bazel/internal/cc-toolchain/features:opt_stub",
            "//bazel/internal/cc-toolchain/features:layering_check",
            "//bazel/internal/cc-toolchain/features:use_module_maps",
            "//bazel/internal/cc-toolchain/features:parse_headers",
            "@rules_cc//cc/toolchains/args/generate_linkmap:feature",
            "@rules_cc//cc/toolchains/args/thin_lto:feature",
        ] + [
            "//bazel/internal/cc-toolchain/features:" + name
            for name in MARKER_FEATURES
        ] + select({
            "@platforms//os:macos": [
                "//bazel/internal/cc-toolchain/features:generate_dsym",
            ],
            "//conditions:default": [],
        }),
        make_variables = select({
            "@platforms//os:macos": [":macos_stack_frame"],
            "//conditions:default": [],
        }),
        module_map = "//bazel/internal/cc-toolchain/tools:builtin_module_map",
        supports_header_parsing = True,
        tags = [TOP_LEVEL_TAG],  # Used below, unclear why this is needed
        tool_map = "//bazel/internal/cc-toolchain/tools:{}_tools".format(platform),
    )
    for platform in PLATFORMS
]

cc_artifact_name_pattern(
    name = "macos-dylib-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:dynamic_library",
    extension = ".dylib",
    prefix = "lib",
)

cc_artifact_name_pattern(
    name = "macos-tbd-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:interface_library",
    extension = ".tbd",
    prefix = "lib",
)

# Bazel's defaults for all of these are the Unix ones, lib%s.a and %s.o and a bare name
# for an executable, so every one of them has to be stated. The prefix is empty rather
# than absent for the same reason: leaving it out means lib, not nothing.
#
# The two .lib patterns look like a mistake and are not. A static library and the import
# library that stands in front of a DLL are both .lib files on Windows and nothing in the
# file name distinguishes them, so the convention is to give the import library an
# infix. .if.lib is the one Bazel's own MSVC toolchain uses and there is no reason to
# invent a different one.
cc_artifact_name_pattern(
    name = "windows-executable-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:executable",
    extension = ".exe",
    prefix = "",
)

cc_artifact_name_pattern(
    name = "windows-object-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:object_file",
    extension = ".obj",
    prefix = "",
)

cc_artifact_name_pattern(
    name = "windows-static-library-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:static_library",
    extension = ".lib",
    prefix = "",
)

cc_artifact_name_pattern(
    name = "windows-alwayslink-static-library-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:alwayslink_static_library",
    extension = ".lo.lib",
    prefix = "",
)

cc_artifact_name_pattern(
    name = "windows-dll-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:dynamic_library",
    extension = ".dll",
    prefix = "",
)

cc_artifact_name_pattern(
    name = "windows-implib-pattern",
    category = "@rules_cc//cc/toolchains/artifacts:interface_library",
    extension = ".if.lib",
    prefix = "",
)

cc_make_variable(
    name = "macos_stack_frame",
    value = "-Wframe-larger-than=100000000 -Wno-vla",
    variable_name = "STACK_FRAME_UNLIMITED",
)

toolchain(
    name = "linux-aarch64-toolchain",
    exec_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    tags = [TOP_LEVEL_TAG],  # Used from MODULE.bazel
    # Constrained by OS and not by CPU. These toolchains already cross compile
    # between Linux CPUs, using the execution platform's clang against the target
    # platform's sysroot, and constraining the CPU here would take that away.
    target_compatible_with = ["@platforms//os:linux"],
    toolchain = ":linux-aarch64_clang_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "linux-x86_64-toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    tags = [TOP_LEVEL_TAG],  # Used from MODULE.bazel
    target_compatible_with = ["@platforms//os:linux"],
    toolchain = ":linux-x86_64_clang_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

toolchain(
    name = "macos-toolchain",
    exec_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
    tags = [TOP_LEVEL_TAG],  # Used from MODULE.bazel
    target_compatible_with = ["@platforms//os:macos"],
    toolchain = ":macos_clang_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# Windows target, cross compiled from Linux x86_64, and only from there.
#
# The name of a cc_toolchain above says which machine runs it and not what it produces.
# That was already true before Windows existed here, which is what the comment on the
# aarch64 registration is getting at, and it is what makes this cheap. Every select
# inside those cc_toolchain definitions is keyed on the target platform, so pointing a
# second toolchain() at an existing cc_toolchain with a Windows target picks up the
# Windows flags without duplicating anything.
#
# Only one execution platform, and that is a real limitation rather than a decision to
# be tidy. Several selects in this toolchain are keyed on the target platform but mean
# the execution platform: which clang tarball to take the resource directory and the
# builtin headers from, for instance, in tools/BUILD.bazel. Those work today because
# for a Linux or macOS target the two happen to agree. They stop agreeing the moment
# you cross compile to a third OS, and a target keyed select cannot tell macOS host
# from Linux host, so it has to be pinned to one host and Linux x86_64 is the one the
# project builds on. Registering macOS as well would not fail, it would quietly hand a
# macOS clang the Linux clang's resource directory, which is worse.
#
# Lifting that needs execution platform keyed config settings, which do not exist here
# yet. Until then, cross compile from Linux x86_64.
#
# Execution still happens on the host either way, so the bash toolchain drivers are
# untouched and none of this is a step toward building on Windows, which is M6.
toolchain(
    name = "windows-x86_64-toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    tags = [TOP_LEVEL_TAG],  # Used from MODULE.bazel
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    toolchain = ":linux-x86_64_clang_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# gazelle:ignore
cc_library(name = "empty_lib")

# Explicitly depend on the asan lib so that it appears in runfiles and works with 'bazel run'
cc_import(
    name = "asan_lib",
    shared_library = select({
        "//:linux_aarch64": "@clang-linux-aarch64//:lib/clang/22/lib/aarch64-unknown-linux-gnu/libclang_rt.asan.so",
        "//:linux_x86_64": "@clang-linux-x86_64//:lib/clang/22/lib/x86_64-unknown-linux-gnu/libclang_rt.asan.so",
        "@platforms//os:macos": "@clang-macos//:lib/clang/22/lib/darwin/libclang_rt.asan_osx_dynamic.dylib",
    }),
)

cc_import(
    name = "tsan_macos_lib",
    shared_library = "@clang-macos//:lib/clang/22/lib/darwin/libclang_rt.tsan_osx_dynamic.dylib",
    target_compatible_with = ["@platforms//os:macos"],
)

cc_import(
    name = "ubsan_macos_lib",
    shared_library = "@clang-macos//:lib/clang/22/lib/darwin/libclang_rt.ubsan_osx_dynamic.dylib",
    target_compatible_with = ["@platforms//os:macos"],
)

alias(
    name = "extra_lib",
    actual = select({
        "//:asan": ":asan_lib",
        "//:tsan_macos": ":tsan_macos_lib",
        "//:ubsan_macos": ":ubsan_macos_lib",
        "//conditions:default": ":empty_lib",
    }),
    tags = [TOP_LEVEL_TAG],  # Used from .bazelrc
)

filegroup(
    name = "coverage_support",
    srcs = [
        ":collect-cc-coverage.sh",
        "@bazel_tools//tools/test:coverage_support",
    ] + select({
        "//:linux_aarch64": [
            "@clang-linux-aarch64//:bin/llvm-cov",
            "@clang-linux-aarch64//:bin/llvm-profdata",
        ],
        "//:linux_x86_64": [
            "@clang-linux-x86_64//:bin/llvm-cov",
            "@clang-linux-x86_64//:bin/llvm-profdata",
        ],
        "@platforms//os:macos": [
            "@clang-macos//:bin/llvm-cov",
            "@clang-macos//:bin/llvm-profdata",
        ],
    }),
    tags = [TOP_LEVEL_TAG],  # Used from .bazelrc
)
