load("@rules_cc//cc/toolchains:args.bzl", "cc_args")

package(default_visibility = ["//visibility:public"])

cc_args(
    name = "resource_dir_args",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    allowlist_include_directories = [
        "//bazel/internal/cc-toolchain/tools:resource_directory",
    ],
    args = [
        "-resource-dir={resource_dir}",
    ],
    data = [
        "//bazel/internal/cc-toolchain/tools:resource_directory_filegroup",
    ],
    format = {
        "resource_dir": "//bazel/internal/cc-toolchain/tools:resource_directory_filegroup",
    },
)

cc_args(
    name = "compile_and_link_args",
    actions = [
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "-no-canonical-prefixes",
    ] + select({
        "//:linux_x86_64": ["--target=x86_64-unknown-linux-gnu"],
        "//:linux_aarch64": ["--target=aarch64-unknown-linux-gnu"],
        # TODO: Pull 11.0 from config set in .bazelrc
        "@platforms//os:macos": ["--target=arm64-apple-macosx11.0"],
        # msvc and not gnu. The gnu triple would give us a mingw build, which is a
        # different ABI and a different C library, and would not interoperate with
        # anything anybody has on a Windows machine. This is still clang's GNU driver,
        # only the target changed, so every other flag in this file keeps its spelling.
        "@platforms//os:windows": ["--target=x86_64-pc-windows-msvc"],
    }) + select({
        "@platforms//os:linux": [
            # Compress debug info to improve binary size, not supported on macOS
            "-gz",
        ],
        "@platforms//os:macos": [],
        # Accepted by clang for this target, but CodeView is what a Windows debugger
        # reads and compressing it is not a thing, so there is nothing to gain.
        "@platforms//os:windows": [],
    }),
    env = {
        "ZERO_AR_DATE": "1",  # Required for hermetic links on macOS (default dependent)
    },
)

cc_args(
    name = "compile_warnings",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        # At the top to allow negation
        "-Wall",
        "-Wextra",
        "-pedantic",

        # Other warnings
        "-Wcast-qual",
        "-Wcovered-switch-default",
        "-Wctad-maybe-unsupported",
        "-Wdelete-non-virtual-dtor",
        "-Wimplicit-fallthrough",
        "-Wmisleading-indentation",
        "-Wmissing-field-initializers",
        "-Wno-builtin-macro-redefined",
        "-Wno-c++17-attribute-extensions",
        "-Wno-c++20-attribute-extensions",
        "-Wno-c2y-extensions",
        "-Wno-dollar-in-identifier-extension",
        "-Wno-gcc-compat",
        "-Wno-gnu-statement-expression-from-macro-expansion",
        "-Wno-gnu-zero-variadic-macro-arguments",
        "-Wno-long-long",
        "-Wno-noexcept-type",
        "-Wno-strict-prototypes",
        "-Wno-unused-parameter",
        "-Wnon-virtual-dtor",
        "-Wself-assign",
        "-Wstring-conversion",
        "-Wsuggest-override",
        "-Wthread-safety",
        "-Wwrite-strings",
        "-Wundef",
    ],
)

cc_args(
    name = "compile_warnings_as_errors",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        # If this error hits it's a misconfiguration of clang
        "-Werror=debug-compression-unavailable",

        # Bazel misconfiguration
        "-Werror=unused-command-line-argument",

        # Forbid return C++ types from exposed C functions
        "-Werror=return-type-c-linkage",

        # Build system misconfiguration
        "-Werror=incomplete-umbrella",

        # Forbid global constructors. These generally break library layering, and have
        # various more appropriate workarounds.
        "-Werror=global-constructors",
    ],
)

cc_args(
    name = "compile_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fcolor-diagnostics",
        "-ffile-compilation-dir=.",  # Avoid absolute paths in binaries
        "-fno-exceptions",
        "-fno-omit-frame-pointer",
        "-fno-rtti",
        "-fstack-protector",
        "-funwind-tables",
        "-fvisibility-inlines-hidden",
        "-fvisibility=hidden",
        "-DGOOGLE_PROTOBUF_NO_RTTI=1",
        "-DLLVM_BUILD_STATIC",
        "-U_FORTIFY_SOURCE",
        '-D__DATE__="redacted"',
        '-D__TIME__="redacted"',
        '-D__TIMESTAMP__="redacted"',
        # Use fallback MLIR TypeIDs to allow sending MLIR objects between shared libraries.
        # This should be defined by any compile target that uses MLIR types.
        "-DMLIR_USE_FALLBACK_TYPE_IDS=1",
    ] + select({
        # Two flags that were unconditional until Windows needed them not to be. Linux
        # and macOS still get both, so nothing changes for them.
        #
        # -fPIC is a hard error for the msvc target and not a warning. PE is relocated
        # through a base relocation table rather than through position independent code,
        # so there is no other mode to ask for and clang refuses the flag outright.
        #
        # -fno-autolink is the one that matters. On COFF, clang records which import
        # libraries an object needs by emitting /DEFAULTLIB directives into the object,
        # and that is how the MSVC standard library and the CRT get onto the link line.
        # -fno-autolink suppresses those directives, and the link then fails on
        # std::_Xlength_error, _Mtx_lock and every other STL out of line symbol. On
        # Linux and macOS the flag is about frameworks and pragma comment(lib), which
        # is why it is safe there and not here.
        "@platforms//os:windows": [],
        "//conditions:default": [
            "-fno-autolink",
            "-fPIC",
        ],
    }) + select({
        "@platforms//os:linux": [
            "-fdata-sections",
            "-ffunction-sections",
        ],
        "@platforms//os:macos": [],
        # Left off rather than turned on, because /OPT:REF already discards unreferenced
        # COFF sections and turning these on as well would only change section counts.
        "@platforms//os:windows": [],
    }) + select({
        # Match the Mojo toolchain's target-cpu so AVX-512 doesn't leak
        # into auto-vectorized C++ stdlib code on AVX-512-capable hosts.
        "//:linux_x86_64": ["-march=x86-64-v3"],
        "//:linux_aarch64": ["-mcpu=neoverse-n1"],
        "@platforms//os:macos": [],
        # Not the same baseline as linux x86_64, for the reason written out next to
        # --target-cpu in bazel/internal/BUILD.bazel: these binaries are downloaded
        # by people whose hardware nobody here knows anything about. The two numbers
        # have to agree, so change them together.
        "@platforms//os:windows": ["-march=x86-64-v2"],
    }),
)

cc_args(
    name = "cpp_compile_args",
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions",
        "@rules_cc//cc/toolchains/actions:objcpp_compile",
    ],
    args = [
        "-std=c++20",
    ] + select({
        "@platforms//os:linux": ["-stdlib=libstdc++"],
        "@platforms//os:macos": ["-stdlib=libc++"],
        # There is only one standard library for this target, the one Microsoft ships,
        # and clang ignores -stdlib entirely when targeting msvc. Passing it anyway trips
        # -Werror=unused-command-line-argument, so the arm is empty on purpose.
        "@platforms//os:windows": [],
    }),
)

cc_args(
    name = "link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        # TODO: Revisit, copied from toolchains_llvm
        "-fuse-ld=lld",
    ] + select({
        "@platforms//os:linux": [
            "-lm",
            "-lstdc++",
            "-Wl,--build-id=md5",
            "-Wl,--hash-style=gnu",
            "-Wl,-z,relro,-z,now",

            # This is required for CXXDriver library sideloading to work.
            # See https://github.com/modularml/modular/pull/2884.
            # This linker can create the new dynamic tags in ELF. But the older ELF
            # systems may not understand them. If you specify --enable-new-dtags, the
            # dynamic tags will be created as needed. If you specify --disable-new-dtags,
            # no new dynamic tags will be created. By default, the new dynamic tags are
            # not created. Note that those options are only available for ELF systems.
            "-Wl,--disable-new-dtags",

            # Virtually disable dlclose, this is copied from HandleLLVMOptions.cmake, but
            # doesn't seem ideal to be relying on, which we are heavily
            "-Wl,-z,nodelete",
        ],
        "@platforms//os:macos": [
            "-headerpad_max_install_names",
            "-lc++",
            "-Wl,-framework,Foundation",
            "-Wl,-no_warn_duplicate_libraries",
            "-Wl,-oso_prefix,.",  # Strip absolute paths from debug info file references
        ],
        # None of the Linux arm carries over. That is mostly ELF hardening and ELF
        # dynamic tags, and the macOS arm is Mach-O install names, and COFF has neither
        # concept. The CRT and the standard library arrive through the /DEFAULTLIB
        # directives that cl and clang put in the objects themselves, which is why there
        # is no Windows equivalent of -lm and -lstdc++ here. Undefined symbols are
        # already an error for lld-link by default, so -Wl,-z,defs needs no counterpart.
        #
        # What is here instead is the list every Windows build system has linked by
        # default since the mid nineties. cl.exe links it, Bazel's own MSVC toolchain
        # links it, and every CMake project on the platform gets it without asking. So
        # third party code written for Windows assumes it is there and simply does not
        # name these libraries, and it is not going to start. That is what happened to
        # @bazel_tools//src/tools/launcher, which calls RegGetValueW and never mentions
        # advapi32 because on Windows nobody has to.
        #
        # The rule for this tree, then. These ten are the toolchain's job and get named
        # here. Anything outside the list is the target's job and gets named in its own
        # linkopts, the way bcrypt is in mimalloc.BUILD and shlwapi is in the
        # google_benchmark patch. The line is drawn where it is because we can edit our
        # own targets and cannot edit somebody else's, not because these ten are special.
        #
        # An import an executable never calls costs a few bytes in the import table and
        # nothing at runtime, since the loader binds thunks lazily per DLL actually used.
        # Being wrong in this direction is cheap. Being wrong the other way is an
        # undefined symbol at the end of a long link.
        #
        # -Wl, because clang's GNU driver reads a leading slash as a path, and because
        # bare -DEFAULTLIB:advapi32.lib is parsed as -D EFAULTLIB:advapi32.lib, a macro
        # definition, which links clean and drops the library on the floor.
        "@platforms//os:windows": [
            "-Wl,/DEFAULTLIB:advapi32.lib",
            "-Wl,/DEFAULTLIB:comdlg32.lib",
            "-Wl,/DEFAULTLIB:gdi32.lib",
            "-Wl,/DEFAULTLIB:kernel32.lib",
            "-Wl,/DEFAULTLIB:ole32.lib",
            "-Wl,/DEFAULTLIB:oleaut32.lib",
            "-Wl,/DEFAULTLIB:shell32.lib",
            "-Wl,/DEFAULTLIB:user32.lib",
            "-Wl,/DEFAULTLIB:uuid.lib",
            "-Wl,/DEFAULTLIB:winspool.lib",
        ],
    }) + select({
        # Sanitizers are split across multiple libraries, some of which aren't linked to shared libraries
        "//:asan_linux": ["-Wl,-z,undefs"],
        "//:tsan_linux": ["-Wl,-z,undefs"],
        "//:ubsan_linux": ["-Wl,-z,undefs"],
        # Error on undefined symbols
        "@platforms//os:linux": ["-Wl,-z,defs"],
        "//conditions:default": [],
    }) + select({
        "//:modular_config_coverage": ["-fprofile-instr-generate"],
        "//conditions:default": [],
    }),
    # linker-driver.sh strips the $ORIGIN rpath entries rules_cc generates for every
    # directory a target's dynamic dependencies live in, because lld-link has no -rpath
    # and reads the path that follows it as an input file. The driver runs on the host
    # and cannot tell what it is linking for, so it needs to be told, and this is where
    # it gets told.
    #
    # It used to be told by the interface library feature instead, which was wrong in a
    # way that only showed up on executables: that feature applies to dynamic library
    # link actions, so shared libraries got their rpaths stripped and binaries did not.
    # A cc_binary with a shared dependency still failed on "could not open
    # '$ORIGIN/../../_solib_win64/_USupport'" long after the fix was supposedly in.
    # Every link action needs the answer, not just the ones that also produce an import
    # library, so it belongs here with the rest of the link arguments.
    env = select({
        "@platforms//os:windows": {"WINDOWS": "true"},
        "//conditions:default": {},
    }),
)

cc_args(
    name = "link_executable_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_executable_actions"],
    args = select({
        "@platforms//os:macos": [
            "-Wl,-pie",
            "-Wl,-rpath,@loader_path/../lib",
        ],
        "@platforms//os:linux": [
            "-Wl,-pie",
            "-Wl,-rpath,$ORIGIN/../lib",
        ],
        # -pie has no meaning for COFF, and rpath has no equivalent at all. Windows
        # resolves DLLs by search order at load time rather than by a path recorded in
        # the binary, so getting a private lib directory onto that search path is a
        # runtime layout problem and not a link flag. lld-link only warns about both of
        # these rather than failing, which is worse than failing, because it means a
        # wrong link line looks like a working one.
        "@platforms//os:windows": [],
    }),
)

cc_args(
    name = "link_shared_library_args",
    actions = ["@rules_cc//cc/toolchains/actions:dynamic_library_link_actions"],
    args = select({
        "@platforms//os:macos": [
            "-Wl,-rpath,@loader_path",
            "-Wl,-rpath,@loader_path/../lib",
        ],
        "@platforms//os:linux": [
            "-Wl,-rpath,$ORIGIN",
            "-Wl,-rpath,$ORIGIN/../lib",
        ],
        # Same reason as the executable case, see above.
        "@platforms//os:windows": [],
    }),
)

cc_args(
    name = "opt_compile_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-D_FORTIFY_SOURCE=1",
        "-DNS_BLOCK_ASSERTIONS=1",
    ],
)

cc_args(
    name = "opt_link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = select({
        "@platforms//os:linux": ["-Wl,--gc-sections"],
        "@platforms//os:macos": ["-Wl,-dead_strip"],
        # The COFF spelling of the same idea. lld-link takes MSVC style arguments even
        # though clang's GNU driver is what hands them over, so this is /OPT:REF and not
        # --gc-sections. Getting that wrong is quiet: lld-link warns about an unknown
        # argument and links anyway, so the size win just silently does not happen.
        "@platforms//os:windows": ["-Wl,/OPT:REF"],
    }),
)

cc_args(
    name = "non_opt_link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = select({
        "@platforms//os:macos": ["-Wl,-no_deduplicate"],
        "//conditions:default": [],
    }),
)

cc_args(
    name = "asan_compile_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fno-sanitize-recover=all",
        "-fsanitize=address",
    ],
)

cc_args(
    name = "asan_link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-fsanitize=address",
        "-shared-libsan",
    ],
)

cc_args(
    name = "tsan_compile_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fno-sanitize-recover=all",
        "-fsanitize=thread",
    ],
)

cc_args(
    name = "tsan_link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-fsanitize=thread",
    ],
)

cc_args(
    name = "ubsan_compile_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fno-sanitize-recover=all",
        "-fsanitize=undefined",
        "-fno-sanitize=vptr",  # requires rtti
    ],
)

cc_args(
    name = "ubsan_link_args",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = [
        "-fsanitize=undefined",
        # Note: we intentionally don't add `-shared-libsan` here. Doing so
        # makes every UBSan-instrumented binary (including build-time tools
        # like kgen) depend on libclang_rt.ubsan_standalone.so at runtime,
        # but build actions don't get the LD_PRELOAD wiring from
        # runtime_sanitizer_env, so they would fail with "cannot open shared
        # object file". For the dlopen-from-Python case (kbench), we instead
        # rely on the loader explicitly preloading libubsan via
        # ctypes.CDLL(..., mode=RTLD_GLOBAL) before opening the user .so.
        # See kbench_model.py and MOTO-1576.
    ],
)

cc_args(
    name = "generate_dsym",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["--modular-dsym-path={dsym_path}"],
    format = {"dsym_path": "@rules_cc//cc/toolchains/variables:dsym_path"},
    requires_not_none = "@rules_cc//cc/toolchains/variables:dsym_path",
)

cc_args(
    name = "output_exec_path",
    actions = ["@rules_cc//cc/toolchains/actions:link_actions"],
    args = ["--modular-binary-path={output_execpath}"],
    format = {"output_execpath": "@rules_cc//cc/toolchains/variables:output_execpath"},
    requires_not_none = "@rules_cc//cc/toolchains/variables:output_execpath",
)

# TODO: Try to replace with https://github.com/bazelbuild/rules_cc/pull/529
cc_args(
    name = "layering_check_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = [
        "-fmodules-strict-decluse",
        "-Wprivate-header",
    ],
)

cc_args(
    name = "module_name_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = select({
        "@platforms//os:macos": ["-Xclang"],
        "//conditions:default": [],
    }) + ["-fmodule-name={module_name}"],
    format = {
        "module_name": "@rules_cc//cc/toolchains/variables:module_name",
    },
    requires_not_none = "@rules_cc//cc/toolchains/variables:module_name",
)

cc_args(
    name = "module_map_file_args",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = select({
        "@platforms//os:macos": ["-Xclang"],
        "//conditions:default": [],
    }) + ["-fmodule-map-file={module_map_file}"],
    format = {
        "module_map_file": "@rules_cc//cc/toolchains/variables:module_map_file",
    },
    requires_not_none = "@rules_cc//cc/toolchains/variables:module_map_file",
)

cc_args(
    name = "dependent_module_map_files",
    actions = ["@rules_cc//cc/toolchains/actions:compile_actions"],
    args = select({
        "@platforms//os:macos": ["-Xclang"],
        "//conditions:default": [],
    }) + [
        "-fmodule-map-file={dependent_module_map_files}",
    ],
    format = {
        "dependent_module_map_files": "@rules_cc//cc/toolchains/variables:dependent_module_map_files",
    },
    iterate_over = "@rules_cc//cc/toolchains/variables:dependent_module_map_files",
    requires_not_none = "@rules_cc//cc/toolchains/variables:dependent_module_map_files",
)

cc_args(
    name = "parse_headers_args",
    actions = ["@rules_cc//cc/toolchains/actions:cpp_header_parsing"],
    args = [
        "-xc++-header",  # TODO: This is wrong for C only headers https://github.com/bazelbuild/bazel/pull/22971
        "-fsyntax-only",
    ],
    env = {
        "PARSE_HEADER": "{output_file}",
    },
    format = {"output_file": "@rules_cc//cc/toolchains/variables:output_file"},
    requires_not_none = "@rules_cc//cc/toolchains/variables:output_file",
)

# TODO: Ideally these would be fixed in rules_cc
cc_args(
    name = "ignore_unused_command_line_argument",
    actions = [
        "@rules_cc//cc/toolchains/actions:lto_backend",
        "@rules_cc//cc/toolchains/actions:cpp_header_parsing",
    ],
    args = ["-Wno-unused-command-line-argument"],
)
