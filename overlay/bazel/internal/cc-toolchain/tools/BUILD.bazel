load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@host-clang//:host_clang.bzl", "HOST_IS_WINDOWS")
load("@host-python//:host_python.bzl", "HOST_PYTHON")
load("@rules_cc//cc/toolchains:tool.bzl", "cc_tool")
load("//bazel:config.bzl", "TOP_LEVEL_TAG")
load(":builtin_module_map.bzl", "builtin_module_map")
load(":tools.bzl", "declare_tools")

package(default_visibility = ["//visibility:public"])

# The three drivers are Python scripts and a Windows host cannot spawn one. There is no
# shebang on Windows, and CreateProcess refuses a .py whatever the file association
# says, so the action does not fail, it fails to start:
#
#     CreateProcessW("...\\multi-platform-clang++.py" -DNOMINMAX ...):
#     %1 is not a valid Win32 application. (error: 193)
#
# So each one gets a .bat beside it naming an interpreter, and that is what the cc_tool
# points at on a Windows host. Bazel does know how to start a .bat, through cmd.exe.
#
# The interpreter is written in as an absolute path because the action's PATH will not
# find it. --incompatible_strict_action_env is set upstream, so an action gets system32,
# windows, wbem and powershell and nothing else, and no Python installer puts anything
# in any of them. host_python_repository.bzl is what resolves it and says more.
#
# The script is named by its path from the execroot, which is the directory an action
# runs in, rather than by %~dp0 relative to the .bat. The .bat is generated and so lives
# under bazel-out while the script it runs is a source file, so the two are not actually
# beside each other and the obvious spelling would look right and be wrong.
_DRIVERS = [
    "multi-platform-clang",
    "multi-platform-clang++",
    "linker-driver",
]

[
    write_file(
        name = "{}-launcher".format(driver),
        out = "{}.bat".format(driver),
        content = [
            "@echo off",
            '"{}" "{}\\{}.py" %*'.format(
                HOST_PYTHON,
                package_name().replace("/", "\\"),
                driver,
            ),
        ],
        newline = "windows",
        tags = ["manual"],
    )
    for driver in _DRIVERS
] if HOST_IS_WINDOWS else []

# Which clang runs when the target is Windows. Two machines can build a Windows
# target now, a Linux x86_64 host cross compiling and a Windows host building
# natively, and the tool has to be one the machine doing the work can execute.
# The selects below are keyed on the target, which is Windows either way, so the
# answer comes from the host instead. host_clang_repository.bzl says why that is
# a repository rule and not a config setting.
#
# Only Windows needs asking. For the other three, host and target agree in every
# combination this project builds, so a target keyed select gets the right answer
# and always has.
WINDOWS_TOOL_PLATFORM = "windows-x86_64" if HOST_IS_WINDOWS else "linux-x86_64"

# The Windows clang is behind a conditional and the other three are not, which
# looks inconsistent and is not. The three carry every clang the driver might
# pick, so that one cc_tool works whatever machine the action lands on, and they
# cost the same on every host. The Windows one would be another 800 megabytes
# fetched by every Linux and macOS developer to cover a case that cannot happen,
# since the driver picks by asking what it is running on and a machine that is
# not Windows will never name it. So it is listed only where it can be chosen.
WINDOWS_CLANG = ["@clang-windows-x86_64//:bin/clang.exe"] if HOST_IS_WINDOWS else []

WINDOWS_CLANGXX = ["@clang-windows-x86_64//:bin/clang++.exe"] if HOST_IS_WINDOWS else []

WINDOWS_LINKER = [
    "@clang-windows-x86_64//:bin/clang.exe",
    "@clang-windows-x86_64//:bin/clang++.exe",
    "@clang-windows-x86_64//:bin/dsymutil.exe",
    "@clang-windows-x86_64//:ld",
] if HOST_IS_WINDOWS else []

# The tools below that are the compiler's own files rather than something it
# produces. Which archive they come from is decided by the machine that runs
# clang, so they all need the same treatment and it is easier to see that when
# the list has a name.
HOST_TOOLS = [
    "builtin_headers",
    "clang-format",
    "clang-tidy",
    "clangd",
    "llvm-install-name-tool",
    "llvm-objcopy",
    "llvm-otool",
    "resource_directory",
    "resource_directory_filegroup",
]

# What the cc_tool below points at, and what has to travel with it. The .bat on a
# Windows host, with the script it runs added as data so that it is in the action's
# inputs. The script itself everywhere else, since everywhere else can start one.
_DRIVER_SRC = {
    driver: ":{}.bat".format(driver) if HOST_IS_WINDOWS else ":{}.py".format(driver)
    for driver in _DRIVERS
}

_DRIVER_DATA = {
    driver: [":{}.py".format(driver)] if HOST_IS_WINDOWS else []
    for driver in _DRIVERS
}

cc_tool(
    name = "multi-platform-clang",
    src = _DRIVER_SRC["multi-platform-clang"],
    data = _DRIVER_DATA["multi-platform-clang"] + [
        "@clang-linux-aarch64//:bin/clang",
        "@clang-linux-x86_64//:bin/clang",
        "@clang-macos//:bin/clang",
    ] + WINDOWS_CLANG,
    tags = ["manual"],
)

cc_tool(
    name = "multi-platform-clang++",
    src = _DRIVER_SRC["multi-platform-clang++"],
    data = _DRIVER_DATA["multi-platform-clang++"] + [
        "@clang-linux-aarch64//:bin/clang++",
        "@clang-linux-x86_64//:bin/clang++",
        "@clang-macos//:bin/clang++",
    ] + WINDOWS_CLANGXX,
    tags = ["manual"],
)

cc_tool(
    name = "multi-platform-linker_driver",
    src = _DRIVER_SRC["linker-driver"],
    data = _DRIVER_DATA["linker-driver"] + [
        "@clang-linux-aarch64//:bin/clang",
        "@clang-linux-aarch64//:bin/clang++",  # symlink to clang
        "@clang-linux-aarch64//:bin/dsymutil",
        "@clang-linux-aarch64//:ld",
        "@clang-linux-x86_64//:bin/clang",
        "@clang-linux-x86_64//:bin/clang++",  # symlink to clang
        "@clang-linux-x86_64//:bin/dsymutil",
        "@clang-linux-x86_64//:ld",
        "@clang-macos//:bin/clang",
        "@clang-macos//:bin/clang++",  # symlink to clang
        "@clang-macos//:bin/dsymutil",
        "@clang-macos//:ld",
    ] + WINDOWS_LINKER,
    tags = [
        "manual",
        # HACK: until our lld contains this fix https://github.com/llvm/llvm-project/commit/9234066476aa82cfac3cee564883a3124df4584e
        # This tag is meaningless to us but changes this behavior https://github.com/bazelbuild/bazel/blob/4c664d9ba50e7d7aea66a0547a5bac3ca8d264e5/src/main/starlark/builtins_bzl/common/cc/link/finalize_link_action.bzl#L363
        "requires_darwin",
    ],
)

declare_tools()

[
    alias(
        name = tool,
        actual = select({
            "//:linux_aarch64": ":linux-aarch64-{}".format(tool),
            "//:linux_x86_64": ":linux-x86_64-{}".format(tool),
            "@platforms//os:macos": ":macos-{}".format(tool),
            # These are the compiler's own files, so what decides them is which machine
            # runs clang and not what clang is asked to produce. For the three arms
            # above those are the same thing, so a target keyed select gets the right
            # answer by accident. Windows is where they come apart, which is what
            # WINDOWS_TOOL_PLATFORM at the top of this file is for.
            "//:windows_x86_64": ":{}-{}".format(WINDOWS_TOOL_PLATFORM, tool),
        }),
        tags = [
            "manual",
            TOP_LEVEL_TAG,
        ],
    )
    for tool in HOST_TOOLS
]

builtin_module_map(
    name = "builtin_module_map",
    include_directories = select({
        "//:linux_aarch64": [
            "@clang-linux-aarch64//:include_dir",
            "@sysroot-jammy-aarch64//sysroot:root",
        ],
        "//:linux_x86_64": [
            "@clang-linux-x86_64//:include_dir",
            "@sysroot-jammy-x86_64//sysroot:root",
        ],
        "@platforms//os:macos": [
            "@clang-macos//:include_dir",
            "@sysroot-macos//sysroot:root",
        ],
        # Host clang headers, as above, and the target's own headers, unlike above. The
        # sysroot half of this genuinely is target keyed, so it is the Windows one, and
        # the clang half asks the host for the reason given at the top of this file.
        "//:windows_x86_64": [
            "@clang-{}//:include_dir".format(WINDOWS_TOOL_PLATFORM),
            "@sysroot-windows//sysroot:root",
        ],
    }),
    tags = ["manual"],
)
