--- a/absl/base/attributes.h
+++ b/absl/base/attributes.h
@@ -138,12 +138,18 @@
 // for further information. Weak attributes do not work across DLL boundary.
 // The MinGW compiler doesn't complain about the weak attribute until the link
 // step, presumably because Windows doesn't use ELF binaries.
+//
+// The clang 9 escape hatch above is gone here. It says weak works on Windows
+// with a new enough clang, and for compiling that is true. Linking is where
+// it falls over: Bazel puts a library's objects inside a start-lib group,
+// which makes each one lazy, and lld-link will not fetch a lazy object to
+// satisfy a reference that is only weak. The definitions in per_thread_sem.cc
+// sit in the group unread and mutex.cc ends up with undefined symbols. Off is
+// the safe answer, and it is what this file already does for MinGW.
 #if (ABSL_HAVE_ATTRIBUTE(weak) ||                                 \
      (defined(__GNUC__) && !defined(__clang__))) &&               \
-    (!defined(_WIN32) ||                                          \
-     (defined(__clang__) && __clang_major__ >= 9 &&               \
-      !defined(ABSL_BUILD_DLL) && !defined(ABSL_CONSUME_DLL))) && \
+    !defined(_WIN32) &&                                           \
     !defined(__MINGW32__)
 #undef ABSL_ATTRIBUTE_WEAK
 #define ABSL_ATTRIBUTE_WEAK __attribute__((weak))
 #define ABSL_HAVE_ATTRIBUTE_WEAK 1
