From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tamnd <1218621+tamnd@users.noreply.github.com>
Date: Wed, 2 Sep 2026 22:01:36 +0800
Subject: compiler: let a downstream build identify itself in mojo --version

The Apache licence grants no trademark rights and "Mojo" is a live Modular
trademark, so a redistributed build that is not from Modular should say so.
Right now there is no way for it to. `mojo --version` prints the same line
whoever built it, and a crash points the reporter at Modular's issue tracker
even when the binary contains changes Modular has never seen. That is unfair to
the people triaging that tracker and confusing for the person filing.

Add three build settings, `//:downstream_id`, `//:downstream_build` and
`//:downstream_upstream_commit`, all defaulting to the empty string. They ride
through the existing versioned template into `GeneratedVersion.h` alongside the
version numbers, and `getDownstreamBuild()` in Config exposes them.

When they are unset, which is every build Modular makes, nothing changes. The
version line is byte for byte what it was and the bug report message is the same
string. Nobody pays for this unless they ask for it.

When they are set, `mojo --version` names the distributor and their revision on
the first line, because the first line is the one that gets pasted into a bug
report and it should be obvious from that line alone where the report belongs. A
second line spells out that the build is unofficial. `--version --verbose` adds
the upstream commit it was built from, which is the piece you actually need to
reproduce anything. The crash handler points at the distributor's tracker rather
than Modular's.

`--verbose` is new in the driver option table so that `mojo --help` lists it.
On its own it is an error rather than silently doing nothing, since it only
means something after `--version`.

Example output from a build with the settings populated:

    Mojo 1.1.0.dev0 (9aba62be84, tamnd/mojo.windows build 3a8aae3)
    unofficial build, not a Modular release, report problems to tamnd/mojo.windows
    built from upstream commit 9aba62be844d73b574a4283a1a8ce760f9843134

Signed-off-by: tamnd <1218621+tamnd@users.noreply.github.com>
---
 BUILD.bazel                                   | 26 ++++++++++
 Config/include/Config/Version.h               | 15 ++++++
 Config/include/GeneratedVersion.h.tmpl        |  4 ++
 Config/lib/Version.cpp                        |  8 +++
 Mojo/tools/mojo/DriverOptions.td              |  5 ++
 Mojo/tools/mojo/mojo.cpp                      | 52 ++++++++++++++++---
 .../modular_versioned_expand_template.bzl     | 10 ++++
 7 files changed, 114 insertions(+), 6 deletions(-)

diff --git a/BUILD.bazel b/BUILD.bazel
index 3e759c983d..6c8833f008 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -117,6 +117,32 @@ string_flag(
     build_setting_default = "deadbeef",
 )
 
+###
+# Downstream distributor identity
+###
+#
+# Empty by default, so a Modular build prints exactly what it printed before and
+# pays nothing for these. Anyone shipping a modified build sets them, and
+# `mojo --version` then names who produced the binary and which upstream commit
+# it came from. The licence grants no trademark rights, and a bug in a modified
+# build is not Modular's to fix, so the binary should say all of that itself
+# rather than relying on whoever files the report to remember.
+
+string_flag(
+    name = "downstream_id",
+    build_setting_default = "",
+)
+
+string_flag(
+    name = "downstream_build",
+    build_setting_default = "",
+)
+
+string_flag(
+    name = "downstream_upstream_commit",
+    build_setting_default = "",
+)
+
 bool_flag(
     name = "use_prebuilt_mojo_toolchain",
     build_setting_default = True,
diff --git a/Config/include/Config/Version.h b/Config/include/Config/Version.h
index ad5d85aa89..e5b0d64069 100644
--- a/Config/include/Config/Version.h
+++ b/Config/include/Config/Version.h
@@ -29,6 +29,21 @@ struct ProjectVersion final {
   const char *buildType;
 };
 
+// Names whoever produced this binary when that is not Modular. Every field is
+// the empty string in a normal build and nothing about the output changes, so an
+// unmodified build pays nothing for this. A distributor shipping a modified
+// build sets the //:downstream_* build settings, and the tools then say plainly
+// that the binary is not a Modular release.
+struct DownstreamBuild final {
+  const char *id;             // who produced it, normally "owner/repo"
+  const char *build;          // their own revision, so a report can be traced
+  const char *upstreamCommit; // the upstream commit it was built from
+
+  bool isSet() const { return id[0] != '\0'; }
+};
+
+DownstreamBuild getDownstreamBuild();
+
 ProjectVersion getMAXVersion();
 ProjectVersion getMojoVersion();
 const char *getMAXVersionString();
diff --git a/Config/include/GeneratedVersion.h.tmpl b/Config/include/GeneratedVersion.h.tmpl
index 6acb972724..a604f5ef66 100644
--- a/Config/include/GeneratedVersion.h.tmpl
+++ b/Config/include/GeneratedVersion.h.tmpl
@@ -20,6 +20,10 @@
 #define MODULAR_BUILD_TYPE_LOWER "@MODULAR_BUILD_TYPE_LOWER@"
 #define MODULAR_VERSION_REVISION "@MODULAR_VERSION_REVISION@"
 
+#define DOWNSTREAM_ID              "@DOWNSTREAM_ID@"
+#define DOWNSTREAM_BUILD           "@DOWNSTREAM_BUILD@"
+#define DOWNSTREAM_UPSTREAM_COMMIT "@DOWNSTREAM_UPSTREAM_COMMIT@"
+
 // TODO: Remove
 #define MODULAR_VERSION_MAJOR    @MODULAR_VERSION_MAJOR@
 #define MODULAR_VERSION_MINOR    @MODULAR_VERSION_MINOR@
diff --git a/Config/lib/Version.cpp b/Config/lib/Version.cpp
index 8b4b20b4b3..e5deac3563 100644
--- a/Config/lib/Version.cpp
+++ b/Config/lib/Version.cpp
@@ -42,6 +42,14 @@ ProjectVersion M::getMojoVersion() {
 
 const char *M::getMojoVersionString() { return MOJO_VERSION_STRING; }
 
+DownstreamBuild M::getDownstreamBuild() {
+  return DownstreamBuild{
+      .id = DOWNSTREAM_ID,
+      .build = DOWNSTREAM_BUILD,
+      .upstreamCommit = DOWNSTREAM_UPSTREAM_COMMIT,
+  };
+}
+
 // TODO: Remove
 
 M::ModularVersion M::getModularVersion() { return M::getMAXVersion(); }
diff --git a/Mojo/tools/mojo/DriverOptions.td b/Mojo/tools/mojo/DriverOptions.td
index 9958fb19c8..29c82d6789 100644
--- a/Mojo/tools/mojo/DriverOptions.td
+++ b/Mojo/tools/mojo/DriverOptions.td
@@ -26,6 +26,11 @@ def version : Flag<["--", "-"], "version">, Group<DiagnosticOptionGroup>,
 def v : Flag<["-"], "v">, Group<DiagnosticOptionGroup>, Alias<version>,
   Index<0>;
 
+def verbose : Flag<["--"], "verbose">, Group<DiagnosticOptionGroup>,
+  Index<1>, HelpText<"With --version, also print the upstream commit this "
+                     "binary was built from. Only produces output for a build "
+                     "that did not come from Modular.">;
+
 //===----------------------------------------------------------------------===//
 // Cache Management Options
 //===----------------------------------------------------------------------===//
diff --git a/Mojo/tools/mojo/mojo.cpp b/Mojo/tools/mojo/mojo.cpp
index e3376e74de..e1a6586399 100644
--- a/Mojo/tools/mojo/mojo.cpp
+++ b/Mojo/tools/mojo/mojo.cpp
@@ -32,6 +32,8 @@
 #include "Support/LogicalResult.h"
 #include "Support/Process.h"
 
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/StringRef.h"
 #include "llvm/CodeGen/CommandFlags.h"
 #include "llvm/Option/ArgList.h"
 #include "llvm/Option/OptTable.h"
@@ -76,10 +78,25 @@ int main(int argc, char **argv) {
 
   KGEN::installOOMHandler();
 
-  llvm::setBugReportMsg(
-      "Please submit a bug report to https://github.com/modular/modular/issues "
-      "and include the crash backtrace along with all the relevant source "
-      "codes.\n");
+  // A crash in a modified build is not Modular's to triage, so point the
+  // reporter at whoever modified it. The string has to outlive this call
+  // because setBugReportMsg keeps the pointer.
+  DownstreamBuild downstream = getDownstreamBuild();
+  if (downstream.isSet()) {
+    static std::string bugReportMsg =
+        llvm::formatv("This binary was not built by Modular. Please submit a "
+                      "bug report to https://github.com/{0}/issues and include "
+                      "the crash backtrace along with all the relevant source "
+                      "codes.\n",
+                      downstream.id)
+            .str();
+    llvm::setBugReportMsg(bugReportMsg.c_str());
+  } else {
+    llvm::setBugReportMsg(
+        "Please submit a bug report to https://github.com/modular/modular/issues "
+        "and include the crash backtrace along with all the relevant source "
+        "codes.\n");
+  }
 
   // Store command line arguments and record the program name.
   SmallVector<const char *, 256> argvStorage(argv, argv + argc);
@@ -117,10 +134,33 @@ int main(int argc, char **argv) {
     // Print the version and exit.
     ProjectVersion version = getMojoVersion();
     const char *versionStr = getMojoVersionString();
-    llvm::outs() << llvm::formatv("Mojo {0} ({1})\n", versionStr,
-                                  version.revision);
+    if (!downstream.isSet()) {
+      llvm::outs() << llvm::formatv("Mojo {0} ({1})\n", versionStr,
+                                    version.revision);
+      return 0;
+    }
+
+    // Somebody other than Modular produced this binary. Say so on the first
+    // line, because the first line is the one that gets pasted into a bug
+    // report, and it should be obvious from that line alone where the report
+    // belongs.
+    llvm::outs() << llvm::formatv("Mojo {0} ({1}, {2} build {3})\n", versionStr,
+                                  version.revision, downstream.id,
+                                  downstream.build);
+    llvm::outs() << llvm::formatv(
+        "unofficial build, not a Modular release, report problems to {0}\n",
+        downstream.id);
+    bool verbose = llvm::any_of(arguments, [](const char *arg) {
+      return llvm::StringRef(arg) == "--verbose";
+    });
+    if (verbose)
+      llvm::outs() << llvm::formatv("built from upstream commit {0}\n",
+                                    downstream.upstreamCommit);
     return 0;
   }
+  case options::OPT_verbose:
+    llvm::errs() << "error: --verbose is only meaningful after --version\n";
+    return 1;
   case options::OPT_print_cache_location: {
     // Resolve the same cache root used by ObjectCompiler / KGENCompiler at
     // runtime, and report where the `.mojo_cache` directory lives.
