From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tamnd <tamnd@users.noreply.github.com>
Date: Wed, 2 Sep 2026 22:44:03 +0800
Subject: build: take library file naming from the target OS in one place

`Support/BUILD.bazel` picked the shared library suffix with a `select()` over
the target OS but set both prefixes and the static suffix outside it, hardcoded
to the ELF and Mach-O convention. That is fine while the only targets are Linux
and macOS, which agree on all three, and it quietly stops being fine anywhere
else. PE does not use a `lib` prefix, so a Windows build that only gained a
suffix arm would ask for `libfoo.dll`, which is a name nothing on the system is
called, and it would fail at the `dlopen` rather than at the build.

Move all four names into one `select()` in `bazel/config.bzl`, one complete arm
per OS, next to the other shared local defines. Adding a platform is now one
arm rather than one arm plus remembering that half the answer lives somewhere
else.

No default arm, deliberately. The `select()` it replaces had no default either,
and that was the right call: an OS nobody has thought about should fail during
analysis with a clear message about which `select()` did not match, rather than
silently inherit another OS's naming conventions and produce a binary that
looks correct until something tries to load a library by name.

`PlatformLibNames.cpp` is the only consumer of these macros and does not change.
Linux and macOS builds get byte identical defines to what they got before.

Signed-off-by: tamnd <1218621+tamnd@users.noreply.github.com>
---
 Support/BUILD.bazel | 11 ++---------
 bazel/config.bzl    | 28 ++++++++++++++++++++++++++++
 2 files changed, 30 insertions(+), 9 deletions(-)

diff --git a/Support/BUILD.bazel b/Support/BUILD.bazel
index ed0961200d..34aa2c5b00 100644
--- a/Support/BUILD.bazel
+++ b/Support/BUILD.bazel
@@ -10,7 +10,7 @@ load(
     "pkg_files",
     "td_library",
 )
-load("//bazel:config.bzl", "ASYNCRT_PROFILING_LOCAL_DEFINES", "CONFIG_SECTION_LOCAL_DEFINES")
+load("//bazel:config.bzl", "ASYNCRT_PROFILING_LOCAL_DEFINES", "CONFIG_SECTION_LOCAL_DEFINES", "PLATFORM_LIB_NAME_LOCAL_DEFINES")
 
 # gazelle:default_visibility //visibility:public
 # gazelle:default_features layering_check,parse_headers
@@ -87,14 +87,7 @@ modular_cc_library(
         "include/Support/STLExtras.h",
         "include/Support/StringExtras.h",
     ],
-    local_defines = [
-        "SHARED_LIBRARY_PREFIX='\"lib\"'",
-        "STATIC_LIBRARY_PREFIX='\"lib\"'",
-        "STATIC_LIBRARY_SUFFIX='\".a\"'",
-    ] + select({
-        "@platforms//os:macos": ["SHARED_LIBRARY_SUFFIX='\".dylib\"'"],
-        "@platforms//os:linux": ["SHARED_LIBRARY_SUFFIX='\".so\"'"],
-    }),
+    local_defines = PLATFORM_LIB_NAME_LOCAL_DEFINES,
     deps = [
         ":ConcurrentAppendingVector",
         ":Globals",
diff --git a/bazel/config.bzl b/bazel/config.bzl
index 586cd6589a..0279af94d5 100644
--- a/bazel/config.bzl
+++ b/bazel/config.bzl
@@ -39,3 +39,31 @@ KERNEL_PROFILING_LOCAL_DEFINES = [
     "MODULAR_ENABLE_GPU_PROFILING=0",
     "MODULAR_ENABLE_GPU_PROFILING_DETAILED=0",
 ]
+
+# How the target OS names library files. Both halves of a name come from the same
+# arm, because prefix and suffix are not independent: ELF and Mach-O want a "lib"
+# prefix and PE does not, so a build that picks the suffix per OS and hardcodes the
+# prefix produces "libfoo.dll", which is a plausible looking name that nothing on
+# the system is called. There is deliberately no default. An OS nobody has thought
+# about should fail here during analysis rather than quietly inherit another OS's
+# naming and go wrong later at a dlopen that cannot find anything.
+PLATFORM_LIB_NAME_LOCAL_DEFINES = select({
+    "@platforms//os:linux": [
+        "SHARED_LIBRARY_PREFIX='\"lib\"'",
+        "SHARED_LIBRARY_SUFFIX='\".so\"'",
+        "STATIC_LIBRARY_PREFIX='\"lib\"'",
+        "STATIC_LIBRARY_SUFFIX='\".a\"'",
+    ],
+    "@platforms//os:macos": [
+        "SHARED_LIBRARY_PREFIX='\"lib\"'",
+        "SHARED_LIBRARY_SUFFIX='\".dylib\"'",
+        "STATIC_LIBRARY_PREFIX='\"lib\"'",
+        "STATIC_LIBRARY_SUFFIX='\".a\"'",
+    ],
+    "@platforms//os:windows": [
+        "SHARED_LIBRARY_PREFIX='\"\"'",
+        "SHARED_LIBRARY_SUFFIX='\".dll\"'",
+        "STATIC_LIBRARY_PREFIX='\"\"'",
+        "STATIC_LIBRARY_SUFFIX='\".lib\"'",
+    ],
+})
